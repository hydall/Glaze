      "VerificationCreateRequest": { "type": "object", "required": ["installationId"], "properties": { "installationId": { "$ref": "#/components/schemas/InstallationId" }, "clientName": { "type": "string" }, "clientVersion": { "type": "string" }, "action": { "const": "character_transfer" } } },
      "VerificationCreateResponse": { "type": "object", "required": ["success", "verificationId", "deviceCode", "verificationUri", "verificationUriComplete", "expiresIn", "interval", "action"], "properties": { "success": { "const": true }, "verificationId": { "type": "string", "format": "uuid" }, "deviceCode": { "type": "string" }, "verificationUri": { "type": "string", "format": "uri" }, "verificationUriComplete": { "type": "string", "format": "uri" }, "expiresIn": { "type": "integer" }, "interval": { "type": "integer" }, "action": { "const": "character_transfer" } } },
      "VerificationLeaseResponse": { "type": "object", "required": ["success", "leaseToken", "tokenType", "leaseHeader", "action", "expiresAt"], "properties": { "success": { "const": true }, "leaseToken": { "type": "string" }, "tokenType": { "const": "DataCat-Verification" }, "leaseHeader": { "const": "X-Datacat-Verification-Lease" }, "action": { "const": "character_transfer" }, "expiresAt": { "type": "string", "format": "date-time" }, "maxUniqueCharacters": { "type": "integer" } } },
      "CapabilitiesResponse": { "type": "object", "required": ["success", "apiVersion", "clientRegistration", "features", "paging", "rateLimiting", "securityCheck", "verification"], "properties": { "success": { "const": true }, "apiVersion": { "const": "v1" }, "clientRegistration": { "type": "object", "additionalProperties": true }, "features": { "type": "object", "additionalProperties": { "type": "boolean" } }, "paging": { "type": "object", "additionalProperties": true }, "rateLimiting": { "type": "object", "additionalProperties": true }, "securityCheck": { "type": "object", "additionalProperties": true }, "verification": { "type": "object", "additionalProperties": true } } },
      "ErrorResponse": { "type": "object", "required": ["success", "error", "message"], "properties": { "success": { "const": false }, "error": { "type": "string" }, "message": { "type": "string" }, "accountState": { "type": "string" }, "verificationRequired": { "type": "boolean" }, "securityCheckRequired": { "type": "boolean" }, "verificationReason": { "type": "string" }, "verification": { "type": "object", "additionalProperties": true }, "securityCheck": { "type": "object", "additionalProperties": true } } }
    }
