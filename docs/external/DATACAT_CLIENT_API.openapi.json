      "Account": { "type": ["object", "null"], "properties": { "uuid": { "type": ["string", "null"], "format": "uuid" }, "username": { "type": ["string", "null"] }, "displayName": { "type": ["string", "null"] }, "userType": { "type": ["string", "null"] } } },
      "AccountLinkCreateRequest": { "type": "object", "required": ["installationId"], "properties": { "installationId": { "$ref": "#/components/schemas/InstallationId" }, "clientName": { "type": "string" }, "clientVersion": { "type": "string" } } },
      "AccountLinkCreateResponse": { "type": "object", "required": ["success", "linkId", "deviceCode", "userCode", "authorizationUri", "authorizationUriComplete", "expiresIn", "interval"], "properties": { "success": { "const": true }, "linkId": { "type": "string", "format": "uuid" }, "deviceCode": { "type": "string" }, "userCode": { "type": "string" }, "authorizationUri": { "type": "string", "format": "uri" }, "authorizationUriComplete": { "type": "string", "format": "uri" }, "verificationUri": { "type": "string", "format": "uri", "deprecated": true }, "verificationUriComplete": { "type": "string", "format": "uri", "deprecated": true }, "expiresIn": { "type": "integer" }, "interval": { "type": "integer" } } },
