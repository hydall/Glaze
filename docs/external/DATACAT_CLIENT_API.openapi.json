          "tags": { "type": "array", "items": { "type": "object", "required": ["id", "name", "slug", "groupId", "count"], "properties": { "id": { "type": "integer" }, "name": { "type": "string" }, "slug": { "type": "string" }, "groupId": { "type": ["integer", "null"] }, "count": { "type": "integer" } } } },
