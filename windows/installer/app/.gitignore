# Widget Preview related
.widget_preview/

# Generated locally to preview the window on Linux; the setup ships for
# Windows only.
/linux/

# Copied from the app's own assets by build_setup.ps1 (and by hand for a local
# run), so the setup uses the same font without a second copy in git.
/assets/fonts/
